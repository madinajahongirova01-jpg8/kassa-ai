NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://kassa:kassa_local_password@localhost:5432/kassa_ai?schema=public
TEST_DATABASE_URL=postgresql://kassa:kassa_local_password@localhost:5432/kassa_ai_test?schema=public

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600

AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

TRUST_PROXY=loopback

ENTRY_PARSE_THROTTLE_LIMIT=20
ENTRY_PARSE_THROTTLE_TTL_SECONDS=60

GEMINI_API_KEY=
GEMINI_MODEL=
