generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  name              String?
  businessName      String?   @map("business_name")
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  customers            Customer[]
  debts                Debt[]
  payments             Payment[]
  cashEntries          CashEntry[]
  telegramAccount      TelegramAccount?
  telegramLinkAttempts TelegramLinkAttempt[]

  @@map("users")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  phone     String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  debts Debt[]

  // Target of the composite foreign key that keeps a debt and its customer under the same owner.
  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
  @@map("customers")
}

enum DebtStatus {
  ACTIVE
  PARTIALLY_PAID
  PAID
}

// Money is stored as integer dirams (1 somoni = 100 dirams) to avoid floating-point errors.
model Debt {
  id           String     @id @default(uuid()) @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  amountDirams Int        @map("amount_dirams")
  paidDirams   Int        @default(0) @map("paid_dirams")
  status       DebtStatus @default(ACTIVE)
  description  String
  occurredOn   DateTime   @map("occurred_on") @db.Date
  dueOn        DateTime?  @map("due_on") @db.Date
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId, ownerId], references: [id, ownerId], onDelete: NoAction)
  payments            Payment[]
  telegramTransaction TelegramTransaction?

  @@unique([id, ownerId])
  @@index([ownerId, status])
  @@index([customerId])
  @@map("debts")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  debtId       String        @map("debt_id") @db.Uuid
  amountDirams Int           @map("amount_dirams")
  method       PaymentMethod @default(CASH)
  paidOn       DateTime      @map("paid_on") @db.Date
  note         String?
  groupId      String        @default(dbgenerated("gen_random_uuid()")) @map("group_id") @db.Uuid
  cancelledAt  DateTime?     @map("cancelled_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  debt  Debt @relation(fields: [debtId, ownerId], references: [id, ownerId], onDelete: NoAction)

  @@index([debtId])
  @@index([groupId])
  @@map("payments")
}

enum CashEntryKind {
  INCOME
  EXPENSE
}

enum CashCategory {
  SALE
  GOODS
  SALARY
  UTILITIES
  TRANSPORT
  RENT
  OTHER
}

enum EntrySource {
  VOICE
  TEXT
  PHOTO
}

// Money that came in or went out of the shop (sales, goods, salaries…), stored as integer dirams.
// Debts and debt payments are not cash entries: they live in their own tables.
model CashEntry {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  kind         CashEntryKind
  category     CashCategory
  amountDirams Int           @map("amount_dirams")
  title        String
  occurredOn   DateTime      @map("occurred_on") @db.Date
  source       EntrySource
  createdAt    DateTime      @default(now()) @map("created_at")

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  telegramTransaction TelegramTransaction?

  @@index([ownerId, occurredOn])
  @@map("cash_entries")
}

enum TelegramAccountStatus {
  ACTIVE
  STOPPED
}

enum TelegramLanguage {
  TG
  RU
  EN
}

// A Telegram chat of a business owner. Integer ids because the bot's repository contracts use numbers.
// Linking to a Kassa user is optional: an unlinked account keeps its own bot-only records.
model TelegramAccount {
  id             Int                   @id @default(autoincrement())
  telegramUserId BigInt                @unique @map("telegram_user_id")
  telegramChatId BigInt                @map("telegram_chat_id")
  firstName      String?               @map("first_name")
  status         TelegramAccountStatus @default(ACTIVE)
  language       TelegramLanguage?
  lastReminderOn DateTime?             @map("last_reminder_on") @db.Date
  userId         String?               @unique @map("user_id") @db.Uuid
  linkedAt       DateTime?             @map("linked_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkCodes    TelegramLinkCode[]
  transactions TelegramTransaction[]

  @@index([status, lastReminderOn])
  @@map("telegram_accounts")
}

// One-time /link codes. Only the SHA-256 hash of a code is stored.
model TelegramLinkCode {
  id        Int       @id @default(autoincrement())
  accountId Int       @map("account_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("telegram_link_codes")
}

enum TelegramTransactionType {
  SALE
  EXPENSE
  CREDIT_SALE
  DEBT_PAYMENT
}

enum TelegramTransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Receipts drafted in Telegram, stored as integer dirams. syncedAt is set when a confirmed receipt
// was written to Kassa data; the reference columns point at what was created there.
// The references are audit-only: they are set in the same transaction that creates the Kassa record
// for the linked owner and are never used to read Kassa data, which is always queried by ownerId.
// paymentGroupId matches payments.group_id, which is not unique, so it has no foreign key.
// CHECK constraints for this model live in migration 20261101120000_telegram_bot (Prisma does not model them).
model TelegramTransaction {
  id             Int                       @id @default(autoincrement())
  accountId      Int                       @map("account_id")
  type           TelegramTransactionType
  amountDirams   Int                       @map("amount_dirams")
  description    String
  customerName   String?                   @map("customer_name")
  status         TelegramTransactionStatus @default(PENDING)
  occurredAt     DateTime                  @default(now()) @map("occurred_at")
  syncedAt       DateTime?                 @map("synced_at")
  cashEntryId    String?                   @unique @map("cash_entry_id") @db.Uuid
  debtId         String?                   @unique @map("debt_id") @db.Uuid
  paymentGroupId String?                   @map("payment_group_id") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at")

  account   TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cashEntry CashEntry?      @relation(fields: [cashEntryId], references: [id], onDelete: SetNull)
  debt      Debt?           @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([accountId, status, occurredAt])
  @@map("telegram_transactions")
}

// Wrong link-code attempts per Kassa user, used to rate-limit the linking endpoint.
model TelegramLinkAttempt {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.Uuid
  attemptedAt DateTime @default(now()) @map("attempted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
  @@map("telegram_link_attempts")
}
